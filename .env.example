# 复制为 .env 并填写你自己的真实值（.env 含密钥，请勿提交）

# 和风天气 API 域名列表（逗号分隔，与 KEYS 一一对应）
VUE_APP_HOSTS=host1.example.com,host2.example.com,host3.example.com

# 和风天气 API 密钥列表（逗号分隔，与 HOSTS 按顺序配对）
VUE_APP_KEYS=key1,key2,key3

# 高德「Web服务」key 不再通过环境变量配置（构建会把 VUE_APP_* 打进包，等于公开）。
# 它现在是壁纸属性面板里的可选项 amapkey：填了地图选点会显示最近道路名，留空照常使用。
# 开发环境在右上角调试面板里填一次即可（存 localStorage）。

# ---- 缓存时效（可选项，单位毫秒）----
# 默认值只集中在 src/config/weatherCache.js，按和风天气官方《缓存你的数据》推荐区间取值：
# https://dev.qweather.com/docs/best-practices/cache/
# 一般不需要在这里配置；确需覆盖时取消对应行的注释即可（超出官方区间会在控制台警告）。

# 实时天气（官方推荐 10-30 分钟）
# VUE_APP_WEATHER_UPDATE_REALTIME=600000

# 逐天预报（官方推荐 1-6 小时）
# VUE_APP_WEATHER_UPDATE_FOURDAYS=7200000

# 天气预警（官方推荐 5-20 分钟）
# VUE_APP_WEATHER_UPDATE_WARNING=600000

# 生活指数（官方推荐 6-12 小时）
# VUE_APP_WEATHER_UPDATE_INDICES=21600000

# 分钟级降水（官方推荐 5-10 分钟；接口本身也是 5 分钟才更新一次）
# VUE_APP_WEATHER_UPDATE_MINUTELY=300000
